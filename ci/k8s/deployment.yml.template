---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: isco
spec:
  replicas: 1
  strategy:
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
    type: RollingUpdate
  selector:
    matchLabels:
      run: isco
  template:
    metadata:
      labels:
        run: isco
        isco-version: "${CI_COMMIT}"
      annotations:
        prometheus.io/scrape: 'true'
        prometheus.io/port: '3000'
    spec:
      containers:
        - name: frontend
          image: eu.gcr.io/akvo-lumen/isco/frontend:${CI_COMMIT}
          ports:
            - containerPort: 80
          resources:
            requests:
              cpu: "100m"
              memory: "32Mi"
            limits:
              cpu: "200m"
              memory: "64Mi"
        - name: backend
          image: eu.gcr.io/akvo-lumen/isco/backend:${CI_COMMIT}
          ports:
            - containerPort: 5000
          env:
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: isco
                  key: database-url
            - name: SECRET_KEY
              valueFrom:
                secretKeyRef:
                  name: isco
                  key: secret-key
            - name: CLIENT_ID
              valueFrom:
                secretKeyRef:
                  name: isco
                  key: client-id
            - name: CLIENT_SECRET
              valueFrom:
                secretKeyRef:
                  name: isco
                  key: client-secret
            - name: WEBDOMAIN
              valueFrom:
                secretKeyRef:
                  name: isco
                  key: webdomain
            - name: EMAIL_HOST
              valueFrom:
                secretKeyRef:
                  name: isco
                  key: email-host
            - name: EMAIL_HOST_USER
              valueFrom:
                secretKeyRef:
                  name: isco
                  key: email-host-user
            - name: EMAIL_HOST_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: isco
                  key: email-host-password
            - name: EMAIL_PORT
              valueFrom:
                secretKeyRef:
                  name: isco
                  key: email-port
                  optional: true
            - name: EMAIL_USE_TLS
              valueFrom:
                secretKeyRef:
                  name: isco
                  key: email-use-tls
                  optional: true
            - name: EMAIL_USE_SSL
              valueFrom:
                secretKeyRef:
                  name: isco
                  key: email-use-ssl
                  optional: true
            - name: BUCKET_FOLDER
              value: ${BUCKET_FOLDER}
            - name: GOOGLE_APPLICATION_CREDENTIALS
              value: /secrets/credentials.json
          volumeMounts:
            - name: isco-secrets
              mountPath: /secrets/credentials.json
              subPath: isco-service-account.json
              readOnly: true
          readinessProbe:
            httpGet:
              path: /health-check
              port: 5000
            initialDelaySeconds: 30
          livenessProbe:
            httpGet:
              path: /health-check
              port: 5000
            initialDelaySeconds: 30
          resources:
            requests:
              cpu: "100m"
              memory: "256Mi"
            limits:
              cpu: "500m"
              memory: "1024Mi"
      volumes:
        - name: isco-secrets
          secret:
            secretName: isco
